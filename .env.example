# Copy to .env and fill in. Never commit .env or your key file.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=~/.kalshi/private_key.pem
# Leave false. true = REAL ORDERS with real money.
LIVE_TRADING=false
# Optional: POST {"text": "..."} here on hard stops (e.g. a local Slack or Discord bridge). Empty = log only.
NOTIFY_URL=
